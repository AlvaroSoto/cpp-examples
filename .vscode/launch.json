{
    // Use IntelliSense para saber los atributos posibles.
    // Mantenga el puntero para ver las descripciones de los existentes atributos.
    // Para más información, visite: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",  // Ejecutable generado por g++
            "args": [],  // Argumentos del programa, si los tienes
            "stopAtEntry": false,  // No detener en la entrada, puedes cambiar a true si quieres detener al inicio
            "cwd": "${fileDirname}", // Establece el directorio de trabajo en la carpeta del proyecto
            "environment": [],  // Variables de entorno, si es necesario
            "externalConsole": false,  // Si deseas usar la consola integrada de VS Code, cámbialo a true si prefieres la consola externa
            "MIMode": "gdb",  // Modo de interfaz de depuración, especificado para usar gdb
            "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",  // Ruta al depurador gdb.exe
            "setupCommands": [
                {
                    "description": "Habilitar el modo de impresión para GDB",
                    "text": "-enable-pretty-printing",  // Mejora la visualización de datos complejos
                    "ignoreFailures": true  // Ignorar fallos si ocurre un problema al ejecutar el comando
                }
            ],
            "preLaunchTask": "C/C++: g++.exe build and debug active file",  // Tarea que compila el archivo antes de ejecutar el programa
            "internalConsoleOptions": "neverOpen"  // No abrir la consola integrada, usa la externa para ver la salida
        }
    ]
}